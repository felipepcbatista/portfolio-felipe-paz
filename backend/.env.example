# Copie para .env e preencha. O .env NUNCA vai para o Git.

# --- MÉTODO 1: Resend (produção) ---
# Hospedagens gratuitas bloqueiam as portas de SMTP. O Resend envia por
# API HTTP, que não é bloqueada. Se RESEND_API_KEY estiver definida, ela
# tem prioridade sobre o SMTP abaixo.
# Crie a chave em https://resend.com/api-keys
RESEND_API_KEY=

# Remetente. Sem domínio próprio verificado, use o padrão do Resend:
# RESEND_FROM=Portfólio <onboarding@resend.dev>
RESEND_FROM=

# --- MÉTODO 2: SMTP do Gmail (desenvolvimento local) ---
# Conta Gmail que envia as mensagens
EMAIL_USER=seu-email@gmail.com

# Senha de app do Gmail (16 caracteres, sem espaços).
# NÃO é a senha da conta. Gere em:
# Conta Google > Segurança > Verificação em duas etapas > Senhas de app
EMAIL_PASS=

# --- DESTINO (obrigatório ao usar Resend) ---
# Para onde as mensagens do formulário são enviadas.
# Com SMTP, se ficar em branco usa o EMAIL_USER.
EMAIL_TO=

# Porta local (a hospedagem define automaticamente em produção)
PORT=3000

# Em produção, defina NODE_ENV=production — ativa o trust proxy,
# necessário para o rate limit contar por IP real atrás do proxy.
# NODE_ENV=production

# Só é necessário se o front-end for hospedado em outro domínio.
# Vazio = a API aceita apenas requisições da própria origem.
# ALLOWED_ORIGIN=https://seu-dominio.com
